#====================================================================
# STEP 17 - FIRST COUPLED TEST: ErgunTestMPI
#====================================================================

# Fluid flows through a column packed with particles. The pressure
# drop is compared with the Ergun equation -> checks that OpenFOAM,
# LIGGGHTS and CFDEM work together.
# The case is copied to the shared folder so ParaView can open it.

CODE:
cp -r $CFDEM_TUT_DIR/cfdemSolverPiso/ErgunTestMPI /root/work/
END CODE

CODE:
cd /root/work/ErgunTestMPI
END CODE

CODE:
nproc
END CODE

# WARNING: the case runs on 4 cores. If nproc prints less than 4,
# STOP here and adapt the case before running it.

CODE:
bash Allrun.sh
END CODE

# First LIGGGHTS fills the column with particles, then the coupled
# CFD-DEM simulation runs.
# An "evince" error at the very end is harmless (no PDF viewer).
# Result plot (simulation vs Ergun):
