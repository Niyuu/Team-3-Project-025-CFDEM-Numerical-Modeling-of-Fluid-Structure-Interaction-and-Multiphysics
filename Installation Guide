#====================================================================
# STEP 19 - PARAVIEW  (IN THE VM, NOT in the container)
#====================================================================

# Leave the container first:

CODE:
exit
END CODE

# Then, in the VM terminal:

CODE:
sudo apt install -y paraview
END CODE

# ParaView needs an empty ".foam" file to recognize an OpenFOAM case:

CODE:
sudo touch ~/cfdem_work/ErgunTestMPI/CFD/case.foam
END CODE

# Files created by root in the container are locked for the VM user;
