#====================================================================
# STEP 1 - IN THE VM TERMINAL: install Docker
#====================================================================

CODE:
sudo apt update && sudo apt install -y docker.io
sudo usermod -aG docker $USER
END CODE

# -> now LOG OUT and LOG BACK IN (or reboot the VM)


#====================================================================
# STEP 2 - IN THE VM TERMINAL: create the Ubuntu 20.04 container, (if you already download Ubuntu's old version you can skip this part)
# (run this ONLY ONCE)
#====================================================================

CODE:
mkdir -p ~/cfdem_work
docker run -it --name cfdem -v ~/cfdem_work:/root/work ubuntu:20.04 bash
END CODE

# You are now inside the container (prompt: root@xxxx:/#)
# Later, to come back into the SAME container, use:

CODE:
docker start -ai cfdem
END CODE

# NEVER run "docker run" again (it creates a new empty container)


#====================================================================
# STEP 3 - INSIDE THE CONTAINER: system packages
#====================================================================

CODE:
export DEBIAN_FRONTEND=noninteractive
apt update && apt install -y build-essential flex bison cmake zlib1g-dev \
  libboost-system-dev libboost-thread-dev libopenmpi-dev openmpi-bin \
  libreadline-dev libncurses-dev libxt-dev git gnuplot python3 nano
END CODE


#====================================================================
# STEP 4 - INSIDE THE CONTAINER: environment variables
#====================================================================

CODE:
echo 'export USER=root' >> ~/.bashrc
echo 'export OMPI_ALLOW_RUN_AS_ROOT=1' >> ~/.bashrc
echo 'export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1' >> ~/.bashrc
END CODE


#====================================================================
# STEP 5 - INSIDE THE CONTAINER: download OpenFOAM-6
#====================================================================

CODE:
mkdir -p ~/OpenFOAM && cd ~/OpenFOAM
git clone https://github.com/OpenFOAM/OpenFOAM-6.git
git clone https://github.com/OpenFOAM/ThirdParty-6.git
echo 'source $HOME/OpenFOAM/OpenFOAM-6/etc/bashrc' >> ~/.bashrc
END CODE


#====================================================================
# STEP 6 - CHECK YOUR PROCESSOR
#====================================================================

CODE:
uname -m
END CODE

# x86_64  (Windows / Intel)      -> SKIP step 7, go to step 8
# aarch64 (Apple Silicon Mac)    -> do step 7


#====================================================================
# STEP 7 - ARM FIX (ONLY if uname -m printed aarch64)
#====================================================================

# 7a) Teach OpenFOAM the ARM architecture.
#     Paste the WHOLE block at once (from "cd" to the last "EOF").

CODE:
cd ~/OpenFOAM/OpenFOAM-6
python3 - <<'EOF'
p = 'etc/config.sh/settings'
s = open(p).read()
if 'aarch64)' in s:
    print('aarch64 already present')
else:
    i = s.index('x86_64)')
    i = s.rfind('\n', 0, i) + 1
    block = """    aarch64)
        WM_ARCH=linuxARM64
        export WM_COMPILER_LIB_ARCH=64
        export WM_CC='gcc'
        export WM_CXX='g++'
        export WM_CFLAGS='-fPIC'
        export WM_CXXFLAGS='-fPIC -std=c++0x'
        export WM_LDFLAGS=
        ;;

"""
    open(p, 'w').write(s[:i] + block + s[i:])
    print('settings file patched')
EOF
END CODE

# Expected output: settings file patched

# 7b) Create ARM compiler rules and remove any failed 32-bit attempt.

CODE:
cd ~/OpenFOAM/OpenFOAM-6/wmake/rules
[ -d linuxARM64Gcc ] || { cp -r linux64Gcc linuxARM64Gcc && sed -i 's/-m64//g' linuxARM64Gcc/*; }
rm -rf ~/OpenFOAM/OpenFOAM-6/wmake/platforms/linuxGcc
END CODE


#====================================================================
# STEP 8 - RELOAD THE ENVIRONMENT AND CHECK
#====================================================================

CODE:
exec bash
echo $USER $WM_ARCH $WM_OPTIONS
END CODE

# Expected:
#   ARM Mac : root linuxARM64 linuxARM64GccDPInt32Opt
#   x86_64  : root linux64 linux64GccDPInt32Opt


#====================================================================
# STEP 9 - COMPILE OpenFOAM-6  (1-3 hours, keep the computer awake)
#====================================================================

CODE:
cd ~/OpenFOAM/OpenFOAM-6
export WM_NCOMPPROCS=$(nproc)
./Allwmake 2>&1 | tee log.Allwmake
END CODE


#====================================================================
# STEP 10 - CHECK THE BUILD
#====================================================================

CODE:
which blockMesh icoFoam simpleFoam pimpleFoam decomposePar
ls $FOAM_LIBBIN | wc -l
ls $FOAM_APPBIN | wc -l
grep -c "Error " log.Allwmake
END CODE

# All 5 programs must be found (our result: 110 libs, 221 apps).
# A few "Error" lines are OK: they come from optional parts we don't use.


#====================================================================
# STEP 11 - TEST: lid-driven cavity
#====================================================================

CODE:
mkdir -p $FOAM_RUN && cd $FOAM_RUN
cp -r $FOAM_TUTORIALS/incompressible/icoFoam/cavity/cavity .
cd cavity
blockMesh | tail -5
icoFoam | tail -8
END CODE

# Both must end with "End"  -> OpenFOAM is ready.



